{
  "version": 2,
  "buildCommand": "cd apps/protocol && npm install && npm run build",
  "outputDirectory": "apps/protocol/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/.well-known/acp", "destination": "/api/acp" },
    { "source": "/api/acp", "destination": "/api/acp" },
    { "source": "/api/acp/(.*)", "destination": "/api/acp" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}